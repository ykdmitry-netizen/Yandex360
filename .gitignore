# --- Локальное окружение ---
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Секреты и локальные настройки ---
# ВАЖНО: .env демо-стенда (мок-токены, локальный пароль БД) лежит в репозитории
# и добавлен через `git add -f` — правило ниже нужно, чтобы случайно не закоммитить
# чужой .env с боевыми доступами. Правя .env под прод, исключайте его из индекса:
#   git update-index --skip-worktree .env
.env
.env.local
*.pem
*.key

# --- Тесты: рабочие каталоги и генерируемые файлы ---
tests/_tmp/
tests/icons.json

# --- Данные стенда (генерируются локально) ---
data/pgdata/
data/logs/
data/backups/
data/tmp/
*.log

# --- Портативный PostgreSQL 17 (~950 МБ, ставится отдельно) ---
tools/pg17/

# --- Редакторы / ОС ---
.vscode/
.idea/
Thumbs.db
desktop.ini
~$*
