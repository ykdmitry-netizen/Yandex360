# Y360 Admin — шаблон окружения. Скопируйте в .env и заполните реальные значения.
#
# Мок-режим: AD_SERVER=mock, IMAP_HOST=mock и YANDEX_API_BASE=http://127.0.0.1:8600
# (запускается скриптом scripts/start-stack.bat). Для боевого контура уберите
# моки и укажите реальные адреса/токены — код менять не нужно.

# --- Яндекс 360 (Directory + Mail API) ---
# OAuth-токен сервисного приложения с правами на directory и mail
YANDEX_TOKEN=
YANDEX_ORG_ID=
# Пусто → боевой https://api360.yandex.net; для мока — http://127.0.0.1:8600
YANDEX_API_BASE=
# token-exchange для IMAP (RFC 8693): клиент сервисного приложения
YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_TOKEN_SCOPE=mail:imap_full

# --- Active Directory (LDAP/LDAPS) ---
# "mock" → встроенный демо-каталог (core/ad_mock.py), для боя — хост КД
AD_SERVER=mock
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_BASE_DN=
AD_SNILS_ATTRIBUTE=snils
AD_USE_SSL=0

# --- PostgreSQL (единая БД консоли) ---
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=y360_admin
PGUSER=y360_app
PGPASSWORD=

# --- Почта и бэкапы ---
# "mock" → встроенный IMAP-мок (services/imap_mock.py), для боя — imap.yandex.ru
IMAP_HOST=mock
IMAP_PORT=993
# Куда складывать снимки ящиков (по умолчанию data/backups проекта)
BACKUP_ROOT=
# Ящик-хранилище для аудиторского восстановления почты (пусто — скрыт в UI)
RESTORE_STORAGE_MAILBOX=
# Срок хранения снимков при автоочистке, дней
RETENTION_DAYS=365
# Через сколько дней после увольнения планируется удаление ящика (fallback,
# если должность не попала ни в одно правило сроков хранения)
DELETE_MAILBOX_AFTER_DAYS=90

# --- Приложение ---
UI_HOST=127.0.0.1
UI_PORT=8080
UI_TITLE=Y360 · Администрирование
# Параллельные запросы к API Яндекс 360
PARALLEL_REQUESTS=4
# Таймаут HTTP/LDAP, секунд
REQUEST_TIMEOUT=20
# 0 = без ограничения (иначе берутся первые N пользователей AD — для отладки)
MAX_USERS=0
# Разрешать локальные адреса (@local) в email-контактах
ALLOW_LOCAL_EMAILS=0
