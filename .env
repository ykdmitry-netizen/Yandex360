# Y360 Admin — локальный стенд (всё на моках, боевой контур не затрагивается).
# Правьте этот файл для подключения реальных AD / Яндекс 360 / PostgreSQL.

# --- Яндекс 360 ---
YANDEX_TOKEN=mock-token
YANDEX_ORG_ID=8365150
YANDEX_API_BASE=http://127.0.0.1:8600
YANDEX_TOKEN_URL=http://127.0.0.1:8600/token
YANDEX_CLIENT_ID=mock-client-id
YANDEX_CLIENT_SECRET=mock-client-secret
YANDEX_TOKEN_SCOPE=mail:imap_full

# --- Active Directory (mock → встроенный LDAP-мок) ---
AD_SERVER=mock
AD_BIND_DN=CN=syncsvc,OU=Service,DC=home,DC=lab
AD_BIND_PASSWORD=mock-bind-password
AD_BASE_DN=DC=home,DC=lab
AD_SNILS_ATTRIBUTE=snils
AD_USE_SSL=0

# --- PostgreSQL ---
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=y360_admin
PGUSER=y360_app
PGPASSWORD=y360_local_pw_2026

# --- Почта (mock → встроенный IMAP-мок) ---
IMAP_HOST=mock
IMAP_PORT=993
RESTORE_STORAGE_MAILBOX=security-store@demo360.test
RETENTION_DAYS=365
DELETE_MAILBOX_AFTER_DAYS=90

# --- Приложение ---
UI_HOST=127.0.0.1
UI_PORT=8080
UI_TITLE=Y360 · Администрирование
PARALLEL_REQUESTS=4
REQUEST_TIMEOUT=20
MAX_USERS=0
ALLOW_LOCAL_EMAILS=0
